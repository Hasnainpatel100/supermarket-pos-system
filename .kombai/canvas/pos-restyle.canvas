        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.th-light{--canvas:#EBEBEB;--inset:#E4E4E4;--raised:#F8F8F8;--input:#FFFFFF;--head:#DADADA;--text:#121212;--muted:#666666;--line:rgba(0,0,0,.06);--edge:#D4D4D4;--primary:#030303;--on-primary:#FFFFFF;--teal:#0D9488;--teal-soft:rgba(13,148,136,.14);--danger:#DC2626;--hover:rgba(255,255,255,.6);--sh-in:inset 0 2px 3px rgba(0,0,0,.09),inset 0 -1px 0 rgba(255,255,255,.75);--sh-up:0 3px 10px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05)}\n.th-dark{--canvas:#121212;--inset:#090909;--raised:#1F1F1F;--input:#161616;--head:#181818;--text:#F2F2F2;--muted:#9A9A9A;--line:rgba(255,255,255,.05);--edge:#2E2E2E;--primary:#F8F8F8;--on-primary:#070707;--teal:#2DD4BF;--teal-soft:rgba(45,212,191,.16);--danger:#F87171;--hover:rgba(255,255,255,.04);--sh-in:inset 0 2px 5px rgba(0,0,0,.75),inset 0 -1px 0 rgba(255,255,255,.04);--sh-up:0 6px 16px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.05)}\n</style>\n<div class=\"font-['Plus_Jakarta_Sans'] antialiased\" data-kid=\"1\" data-name=\"page root with theme fonts\">\n<div class=\"th-light\" data-kid=\"1-1\" data-name=\"light theme screen container\" id=\"screen-light\"></div>\n<div class=\"th-dark\" data-kid=\"1-2\" data-name=\"dark theme screen container\" id=\"screen-dark\"></div>\n</div>\n<template data-kid=\"2\" data-name=\"app UI template\" id=\"tpl\">\n<div class=\"flex h-[900px] w-[1440px] bg-[var(--canvas)] text-[var(--text)]\" data-kid=\"2-1\" data-name=\"pos app screen layout\">\n<aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-1 py-4 text-[var(--muted)]\" data-kid=\"2-1-1\" data-name=\"left icon navigation rail\">\n<span class=\"mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--primary)] text-[var(--on-primary)]\" data-kid=\"2-1-1-1\" data-name=\"brand logo tile\"><i class=\"mdi mdi-storefront-outline text-[22px]\" data-kid=\"2-1-1-1-1\" data-name=\"storefront logo icon\"></i></span>\n<div class=\"flex flex-col items-center gap-1 rounded-2xl bg-[var(--inset)] p-1 shadow-[var(--sh-in)]\" data-kid=\"2-1-1-2\" data-name=\"vertical nav icon group\">\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl hover:text-[var(--text)]\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard nav link\" title=\"Dashboard\"><i class=\"mdi mdi-view-dashboard-outline text-[21px]\" data-kid=\"2-1-1-2-1-1\" data-name=\"dashboard icon\"></i></a>\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl hover:text-[var(--text)]\" data-kid=\"2-1-1-2-2\" data-name=\"pos nav link\" title=\"POS\"><i class=\"mdi mdi-cash-register text-[21px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"cash register icon\"></i></a>\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl hover:text-[var(--text)]\" data-kid=\"2-1-1-2-3\" data-name=\"orders nav link\" title=\"Orders\"><i class=\"mdi mdi-receipt-text-outline text-[21px]\" data-kid=\"2-1-1-2-3-1\" data-name=\"orders receipt icon\"></i></a>\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--raised)] text-[var(--teal)] shadow-[var(--sh-up)]\" data-kid=\"2-1-1-2-4\" data-name=\"items nav link active\" title=\"Items\"><i class=\"mdi mdi-archive-outline text-[21px]\" data-kid=\"2-1-1-2-4-1\" data-name=\"items archive icon\"></i></a>\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl hover:text-[var(--text)]\" data-kid=\"2-1-1-2-5\" data-name=\"stock nav link\" title=\"Stock\"><i class=\"mdi mdi-warehouse text-[21px]\" data-kid=\"2-1-1-2-5-1\" data-name=\"warehouse icon\"></i></a>\n<a class=\"flex h-10 w-10 items-center justify-center rounded-xl hover:text-[var(--text)]\" data-kid=\"2-1-1-2-6\" data-name=\"purchases nav link\" title=\"Purchases\"><i class=\"mdi mdi-shopping-outline text-[21px]\" data-kid=\"2-1-1-2-6-1\" data-name=\"shopping cart icon\"></i></a>\n<a clas