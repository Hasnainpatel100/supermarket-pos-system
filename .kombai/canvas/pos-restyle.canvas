nt-bold\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"backup card title\">Backup</h2>\n<dl class=\"mt-3 flex flex-col text-sm\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"backup details list\">\n<div class=\"flex h-9 items-center justify-between border-b border-[var(--line)]\" data-kid=\"2-1-2-2-2-2-2-1\" data-name=\"destination detail row\"><dt class=\"text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-1-1\" data-name=\"destination label\">Destination</dt><dd class=\"font-semibold\" data-kid=\"2-1-2-2-2-2-2-1-2\" data-name=\"destination path value\">D:\\RH POS\\Backups</dd></div>\n<div class=\"flex h-9 items-center justify-between border-b border-[var(--line)]\" data-kid=\"2-1-2-2-2-2-2-2\" data-name=\"last backup detail row\"><dt class=\"text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-2-1\" data-name=\"last backup label\">Last backup</dt><dd class=\"font-semibold\" data-kid=\"2-1-2-2-2-2-2-2-2\" data-name=\"last backup timestamp value\">31 Oct 2026, 21:40</dd></div>\n<div class=\"flex h-9 items-center justify-between border-b border-[var(--line)]\" data-kid=\"2-1-2-2-2-2-2-3\" data-name=\"file size detail row\"><dt class=\"text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-3-1\" data-name=\"file size label\">File size</dt><dd class=\"font-semibold tabular-nums\" data-kid=\"2-1-2-2-2-2-2-3-2\" data-name=\"file size value\">48.6 MB</dd></div>\n<div class=\"flex h-9 items-center justify-between\" data-kid=\"2-1-2-2-2-2-2-4\" data-name=\"backup state detail row\"><dt class=\"text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-4-1\" data-name=\"state label\">State</dt><dd class=\"flex items-center gap-1.5 font-semibold\" data-kid=\"2-1-2-2-2-2-2-4-2\" data-name=\"backup state value with indicator\"><span class=\"h-2 w-2 rounded-full bg-[var(--teal)]\" data-kid=\"2-1-2-2-2-2-2-4-2-1\" data-name=\"active state indicator dot\"></span>Idle</dd></div>\n</dl>\n<div class=\"mt-auto flex justify-end gap-2 pt-3\" data-kid=\"2-1-2-2-2-2-3\" data-name=\"backup action buttons row\">\n<button class=\"h-10 rounded-xl border border-[var(--edge)] px-4 text-[13px] font-semibold hover:bg-[var(--inset)]\" data-kid=\"2-1-2-2-2-2-3-1\" data-name=\"restore button\">Restore</button>\n<button class=\"h-10 rounded-xl bg-[var(--primary)] px-4 text-[13px] font-semibold text-[var(--on-primary)]\" data-kid=\"2-1-2-2-2-2-3-2\" data-name=\"backup now button\">Back up now</button>\n</div>\n</section>\n</div>\n</div>\n</main>\n</div>\n</template>\n<script>\nconst items=[\n[\"Frooti Mango Juice Tetrapack 160ml\",\"SKU-BV-041\",\"8901614010411\",\"Pack\",8.5,10,48,\"14 Jan 2027\"],\n[\"Real Fruit Power Mixed Fruit Juice 1L\",\"SKU-BV-042\",\"8901207010427\",\"Pack\",105,125,0,\"02 Dec 2026\"],\n[\"Red Bull Energy Drink Can 250ml\",\"SKU-BV-043\",\"9002490100438\",\"Can\",110,125,36,\"20 Jun 2027\"],\n[\"Bisleri Packaged Drinking Water 1L\",\"SKU-BV-044\",\"8906014400442\",\"Bottle\",14,20,120,\"\"],\n[\"Parle-G Gold Glucose Biscuits 1kg Family Pack\",\"SKU-SN-045\",\"8901719010457\",\"Pack\",110,125,0,\"08 Mar 2027\"],\n[\"Britannia Good Day Butter Cookies 600g\",\"SKU-SN-046\",\"8901063030463\",\"Pack\",120,140,22,\"19 Feb 2027\"],\n[\"Britannia Marie Gold Biscuits 300g\",\"SKU-SN-047\",\"8901063040479\",\"Pack\",42,50,64,\"11 Jan 2027\"],\n[\"Cadbury Oreo Original Vanilla 120g\",\"SKU-SN-048\",\"8901233020483\",\"Pack\",32,40,0,\"27 Dec 2026\"],\n[\"Sunfeast Dark Fantasy Choco Fills 300g\",\"SKU-SN-049\",\"8901725030495\",\"Pack\",130,150,18,\"05 Apr 2027\"],\n[\"Haldiram's Aloo Bhujia 400g\",\"SKU-SN-050\",\"8904004400502\",\"Pack\",95,110,15,\"22 Jan 2027\"],\n[\"Amul Taaza Toned Milk 1L\",\"SKU-DR-051\",\"8901262010511\",\"Pouch\",54,58,40,\"04 Nov 2026\"],\n[\"Tata Salt Iodised 1kg\",\"SKU-GR-052\",\"8904043901015\",\"Pack\",24,28,85,\"\"],\n[\"Aashirvaad Whole Wheat Atta 5kg\",\"SKU-GR-053\",\"8901725133917\",\"Bag\",245,275,12,\"30 Mar 2027\"],\n[\"Maggi 2-Minute Masala Noodles 280g\",\"SKU-IN-054\",\"8901058852429\",\"Pack\",52,56,70,\"15 May 2027\"],\n[\"Surf Excel Easy Wash Detergent 1kg\",\"SKU-HC-055\",\"8901030865138\",\"Pack\",125,140,9,\"\"]\n];\nconst inr=n=>'₹'+n.toFixed(2);\nconst rows=items.map(([n,s,b,u,c,p,st,e],i)=>`\n<div class=\"grid h-9 grid-cols-[20px_minmax(0,1fr)_84px_112px_52px_72px_72px_52px_88px_28px] items-center gap-2 whitespace-nowrap rounded-lg px-2 text-sm hover:bg-[var(--hover)] ${i===3?'bg-[var(--hover)]':''}\">\n  <span class=\"h-4 w-4 rounded-[5px] border-[1.5px] ${i===3?'border-[var(--primary)] bg-[var(--primary)] text-[var(--on-primary)] flex items-center justify-center':'border-[var(--edge)] bg-[var(--input)]'}\">${i===3?'<i class=\"mdi mdi-check text-[12px] leading-none\"></i>':''}</span>\n  <span class=\"truncate font-semibold\" title=\"${n}\">${n}</span>\n  <span class=\"text-[13px] text-[var(--muted)]\">${s}</span>\n  <span class=\"font-mono text-[12px] text-[var(--muted)]\">${b}</span>\n  <span class=\"text-[13px]\">${u}</span>\n  <span class=\"text-right tabular-nums\">${inr(c)}</span>\n  <span class=\"text-right font-semibold tabular-nums\">${inr(p)}</span>\n  <span class=\"flex items-center justify-end gap-1.5 font-semibold tabular-nums\">${st===0?'<span class=\"h-1.5 w-1.5 rounded-full bg-[var(--danger)]\"></span>':''}${st}</span>\n  <span class=\"pl-2 text-[13px] ${e?'':'text-[var(--muted)]'}\">${e||'No batch'}</span>\n  <button title=\"Actions\" class=\"flex h-7 w-7 items-center justify-center rounded-lg text-[var(--muted)] hover:text-[var(--text)]\"><i class=\"mdi mdi-dots-vertical text-lg\"></i></button>\n</div>`).join('');\nconst tpl=document.getElementById('tpl');\n['screen-light','screen-dark'].forEach(id=>document.getElementById(id).appendChild(tpl.content.cloneNode(true)));\ndocument.querySelectorAll('[data-rows]').forEach(el=>el.innerHTML=rows);\n</script>",
