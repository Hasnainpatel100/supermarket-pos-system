      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.th-light{--canvas:#EEEEEE;--card:#FCFCFC;--well:#F5F5F5;--text:#161616;--muted:#6B6B6B;--line:#ECECEC;--edge:#DEDEDE;--primary:#060606;--on-primary:#FFFFFF;--teal:#0D9488;--teal-soft:rgba(13,148,136,.14);--danger:#DC2626;--shadow:0 3px 10px rgba(0,0,0,.07),0 1px 2px rgba(0,0,0,.05);--hover:#F3F3F3}\n.th-dark{--canvas:#0B0B0B;--card:#1B1B1B;--well:#242424;--text:#F2F2F2;--muted:#9C9C9C;--line:#262626;--edge:#333333;--primary:#F8F8F8;--on-primary:#0B0B0B;--teal:#2DD4BF;--teal-soft:rgba(45,212,191,.16);--danger:#F87171;--shadow:0 6px 18px rgba(0,0,0,.6),0 1px 3px rgba(0,0,0,.4);--hover:#222222}\n</style>\n<div class=\"font-['Plus_Jakarta_Sans'] antialiased\" data-kid=\"1\" data-name=\"design root container\">\n<div class=\"th-light\" data-kid=\"1-1\" data-name=\"light theme screen\" id=\"screen-light\"></div>\n<div class=\"th-dark\" data-kid=\"1-2\" data-name=\"dark theme screen\" id=\"screen-dark\"></div>\n</div>\n<template data-kid=\"2\" data-name=\"screen template\" id=\"tpl\">\n<div class=\"flex h-[900px] w-[1440px] bg-[var(--canvas)] text-[var(--text)]\" data-kid=\"2-1\" data-name=\"screen layout container\">\n<aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-1.5 py-5 text-[var(--muted)]\" data-kid=\"2-1-1\" data-name=\"icon sidebar navigation\">\n<span class=\"mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--primary)] text-[var(--on-primary)]\" data-kid=\"2-1-1-1\" data-name=\"app logo tile\"><i class=\"mdi mdi-storefront-outline text-[22px]\" data-kid=\"2-1-1-1-1\" data-name=\"storefront logo icon\"></i></span>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-2\" data-name=\"dashboard nav icon button\" title=\"Dashboard\"><i class=\"mdi mdi-vie