      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.th-light{--canvas:#F2F2F2;--surface:#F8F8F8;--dialog:#FFFFFF;--well:#F0F0F0;--well2:#EDEDED;--text:#141414;--muted:#666666;--line:#E8E8E8;--edge:#DADADA;--primary:#040404;--on-primary:#FFFFFF;--teal:#0D9488;--teal-soft:rgba(13,148,136,.14);--danger:#DC2626;--hover:#EFEFEF;--sh-low:0 1px 2px rgba(0,0,0,.05),0 1px 1px rgba(0,0,0,.03);--sh-dlg:0 22px 44px -14px rgba(0,0,0,.2),0 4px 12px rgba(0,0,0,.05);--sh-well:inset 0 1px 2px rgba(0,0,0,.07)}\n.th-dark{--canvas:#070707;--surface:#161616;--dialog:#222222;--well:#181818;--well2:#1E1E1E;--text:#F5F5F5;--muted:#9B9B9B;--line:#262626;--edge:#333333;--primary:#FCFCFC;--on-primary:#090909;--teal:#2DD4BF;--teal-soft:rgba(45,212,191,.16);--danger:#F87171;--hover:#1D1D1D;--sh-low:0 1px 2px rgba(0,0,0,.6);--sh-dlg:0 26px 50px -14px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.04);--sh-well:inset 0 1px 2px rgba(0,0,0,.55)}\n.thin-x::-webkit-scrollbar{height:8px;width:8px}.thin-x::-webkit-scrollbar-thumb{background:var(--edge);border-radius:8px}.thin-x::-webkit-scrollbar-track{background:transparent}\n</style>\n<div class=\"font-['Plus_Jakarta_Sans'] antialiased\" data-kid=\"1\" data-name=\"page root layout container\">\n<div class=\"th-light\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"light theme screen container\" data-reason=\"children injected by script cloning the template\" id=\"screen-light\"></div>\n<div class=\"th-dark\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"dark theme screen container\" data-reason=\"children injected by script cloning the template\" id=\"screen-dark\"></div>\n</div>\n<template data-kid=\"2\" data-name=\"screen design template\" id=\"tpl\">\n<div class=\"flex h-[900px] w-[1440px] bg-[var(--canvas)] text-[var(--text)]\" data-kid=\"2-1\" data-name=\"POS dashboard screen container\">\n<aside class=\"flex w-[72px] shrink-0 flex-col items-center gap-1 py-5 text-[var(--muted)]\" data-kid=\"2-1-1\" data-name=\"sidebar icon navigation\">\n<span class=\"mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--primary)] text-[var(--on-primary)]\" data-kid=\"2-1-1-1\" data-name=\"store logo icon button\"><i class=\"mdi mdi-storefront-outline text-[22px]\" data-kid=\"2-1-1-1-1\" data-name=\"storefront logo icon\"></i></span>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-2\" data-name=\"dashboard nav link\" title=\"Dashboard\"><i class=\"mdi mdi-view-dashboard-outline text-[22px]\" data-kid=\"2-1-1-2-1\" data-name=\"dashboard icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-3\" data-name=\"POS nav link\" title=\"POS\"><i class=\"mdi mdi-cash-register text-[22px]\" data-kid=\"2-1-1-3-1\" data-name=\"cash register icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-4\" data-name=\"orders nav link\" title=\"Orders\"><i class=\"mdi mdi-receipt-text-outline text-[22px]\" data-kid=\"2-1-1-4-1\" data-name=\"receipt orders icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-5\" data-name=\"items nav link\" title=\"Items\"><i class=\"mdi mdi-archive-outline text-[22px]\" data-kid=\"2-1-1-5-1\" data-name=\"archive items icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-6\" data-name=\"stock nav link\" title=\"Stock\"><i class=\"mdi mdi-warehouse text-[22px]\" data-kid=\"2-1-1-6-1\" data-name=\"warehouse stock icon\"></i></a>\n<a class=\"relative flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--dialog)] text-[var(--text)] shadow-[var(--sh-low)]\" data-kid=\"2-1-1-7\" data-name=\"customers nav link (active)\" title=\"Customers\"><i class=\"mdi mdi-account-group-outline text-[22px]\" data-kid=\"2-1-1-7-1\" data-name=\"customers icon\"></i><span class=\"absolute -left-[14px] h-5 w-1 rounded-full bg-[var(--teal)]\" data-kid=\"2-1-1-7-2\" data-name=\"active section indicator bar\"></span></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-8\" data-name=\"expenses nav link\" title=\"Expenses\"><i class=\"mdi mdi-wallet-outline text-[22px]\" data-kid=\"2-1-1-8-1\" data-name=\"wallet expenses icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-9\" data-name=\"reports nav link\" title=\"Reports\"><i class=\"mdi mdi-chart-bar text-[22px]\" data-kid=\"2-1-1-9-1\" data-name=\"bar chart reports icon\"></i></a>\n<div class=\"flex-1\" data-kid=\"2-1-1-10\" data-name=\"sidebar flexible spacer\"></div>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-11\" data-name=\"settings nav link\" title=\"Settings\"><i class=\"mdi mdi-cog-outline text-[22px]\" data-kid=\"2-1-1-11-1\" data-name=\"gear settings icon\"></i></a>\n<a class=\"flex h-11 w-11 items-center justify-center rounded-xl hover:bg-[var(--hover)]\" data-kid=\"2-1-1-12\" data-name=\"log out nav link\" title=\"Log out\"><i class=\"mdi mdi-logout text-[22px]\" data-kid=\"2-1-1-12-1\" data-name=\"logout icon\"></i></a>\n</aside>\n<main class=\"flex min-w-0 flex-1 gap-5 py-5 pr-5\" data-kid=\"2-1-2\" data-name=\"main content area\">\n<!-- Left: customer sheet + backup -->\n<div class=\"flex w-[580px] shrink-0 flex-col gap-5\" data-kid=\"2-1-2-1\" data-name=\"left column with customer form\">\n<section class=\"flex h-[604px] flex-col rounded-2xl bg-[var(--dialog)] shadow-[var(--sh-dlg)]\" data-kid=\"2-1-2-1-1\" data-name=\"new customer form card\">\n<div class=\"flex h-[72px] shrink-0 items-center justify-between px-6\" data-kid=\"2-1-2-1-1-1\" data-name=\"form card header\">\n<h2 class=\"text-xl font-bold tracking-[-0.01em]\" data-kid=\"2-1-2-1-1-1-1\" data-name=\"form card title\">New customer</h2>\n<button class=\"flex h-10 w-10 items-center justify-center rounded-xl text-[var(--muted)] hover:bg-[var(--hover)]\" data-kid=\"2-1-2-1-1-1-2\" data-name=\"close form button\" title=\"Close\"><i class=\"mdi mdi-close text-[22px]\" data-kid=\"2-1-2-1-1-1-2-1\" data-name=\"close icon\"></i></button>\n</div>\n<div class=\"thin-x min-h-0 flex-1 overflow-y-auto px-6 pb-6\" data-kid=\"2-1-2-1-1-2\" data-name=\"scrollable form body\">\n<h3 class=\"text-sm font-semibold\" data-kid=\"2-1-2-1-1-2-1\" data-name=\"contact section heading\">Contact</h3>\n<div class=\"mt-3 flex flex-col gap-3\" data-kid=\"2-1-2-1-1-2-2\" data-name=\"contact fields group\">\n<div data-kid=\"2-1-2-1-1-2-2-1\" data-name=\"customer name field wrapper\">\n<label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-2-1-1\" data-name=\"customer name label\">Customer name <span class=\"text-[var(--danger)]\" data-kid=\"2-1-2-1-1-2-2-1-1-1\" data-name=\"required field asterisk\">*</span></label>\n<input class=\"h-12 w-full rounded-xl border-[1.5px] border-[var(--teal)] bg-[var(--dialog)] px-4 text-[15px] font-medium outline-hidden ring-4 ring-[var(--teal-soft)]\" data-kid=\"2-1-2-1-1-2-2-1-2\" data-name=\"customer name input (focused)\" value=\"Priya Raghavan\"/>\n</div>\n<div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-1-2-1-1-2-2-2\" data-name=\"phone and email field row\">\n<div data-kid=\"2-1-2-1-1-2-2-2-1\" data-name=\"phone field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-2-2-1-1\" data-name=\"phone label\">Phone</label><input class=\"h-12 w-full rounded-xl bg-[var(--well)] px-4 text-[15px] shadow-[var(--sh-well)] outline-hidden\" data-kid=\"2-1-2-1-1-2-2-2-1-2\" data-name=\"phone input field\" value=\"98450 12763\"/></div>\n<div data-kid=\"2-1-2-1-1-2-2-2-2\" data-name=\"email field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-2-2-2-1\" data-name=\"email label\">Email</label><input class=\"h-12 w-full rounded-xl border-[1.5px] border-[var(--danger)] bg-[var(--well)] px-4 text-[15px] outline-hidden\" data-kid=\"2-1-2-1-1-2-2-2-2-2\" data-name=\"email input (invalid)\" value=\"priya.r@gmail\"/><p class=\"mt-1 text-[12.5px] font-medium text-[var(--danger)]\" data-kid=\"2-1-2-1-1-2-2-2-2-3\" data-name=\"email validation error text\">Enter a valid email address</p></div>\n</div>\n</div>\n<h3 class=\"mt-6 text-sm font-semibold\" data-kid=\"2-1-2-1-1-2-3\" data-name=\"address section heading\">Address</h3>\n<div class=\"mt-3 flex flex-col gap-3\" data-kid=\"2-1-2-1-1-2-4\" data-name=\"address fields group\">\n<div data-kid=\"2-1-2-1-1-2-4-1\" data-name=\"street address field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-4-1-1\" data-name=\"street address label\">Street address</label><input class=\"h-12 w-full rounded-xl bg-[var(--well)] px-4 text-[15px] shadow-[var(--sh-well)] outline-hidden\" data-kid=\"2-1-2-1-1-2-4-1-2\" data-name=\"street address input field\" value=\"12, 4th Cross, Jayanagar 3rd Block\"/></div>\n<div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-1-2-1-1-2-4-2\" data-name=\"city and state field row\">\n<div data-kid=\"2-1-2-1-1-2-4-2-1\" data-name=\"city field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-4-2-1-1\" data-name=\"city label\">City</label><input class=\"h-12 w-full rounded-xl bg-[var(--well)] px-4 text-[15px] shadow-[var(--sh-well)] outline-hidden\" data-kid=\"2-1-2-1-1-2-4-2-1-2\" data-name=\"city input field\" value=\"Bengaluru\"/></div>\n<div data-kid=\"2-1-2-1-1-2-4-2-2\" data-name=\"state field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-4-2-2-1\" data-name=\"state label\">State</label><div class=\"flex h-12 items-center justify-between rounded-xl bg-[var(--well)] px-4 text-[15px] shadow-[var(--sh-well)]\" data-kid=\"2-1-2-1-1-2-4-2-2-2\" data-name=\"state dropdown selector\">Karnataka<i class=\"mdi mdi-chevron-down text-xl text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-4-2-2-2-1\" data-name=\"dropdown chevron icon\"></i></div></div>\n</div>\n<div class=\"w-[180px]\" data-kid=\"2-1-2-1-1-2-4-3\" data-name=\"ZIP code field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-4-3-1\" data-name=\"ZIP code label\">ZIP code</label><input class=\"h-12 w-full rounded-xl bg-[var(--well)] px-4 text-[15px] tabular-nums shadow-[var(--sh-well)] outline-hidden\" data-kid=\"2-1-2-1-1-2-4-3-2\" data-name=\"ZIP code input field\" value=\"560011\"/></div>\n</div>\n<h3 class=\"mt-6 text-sm font-semibold\" data-kid=\"2-1-2-1-1-2-5\" data-name=\"other section heading\">Other</h3>\n<div class=\"mt-3 flex flex-col gap-3\" data-kid=\"2-1-2-1-1-2-6\" data-name=\"other fields group\">\n<div data-kid=\"2-1-2-1-1-2-6-1\" data-name=\"notes field wrapper\"><label class=\"mb-1.5 block text-[13px] font-medium\" data-kid=\"2-1-2-1-1-2-6-1-1\" data-name=\"notes label\">Notes</label><textarea class=\"w-full resize-none rounded-xl bg-[var(--well)] px-4 py-3 text-[15px] shadow-[var(--sh-well)] outline-hidden placeholder:text-[var(--muted)]\" data-kid=\"2-1-2-1-1-2-6-1-2\" data-name=\"notes text area input\" placeholder=\"Optional\" rows=\"2\"></textarea></div>\n<div class=\"flex h-12 items-center justify-between\" data-kid=\"2-1-2-1-1-2-6-2\" data-name=\"VIP toggle row\">\n<span class=\"text-sm font-medium\" data-kid=\"2-1-2-1-1-2-6-2-1\" data-name=\"VIP customer label\">VIP customer</span>\n<span class=\"relative h-7 w-12 rounded-full bg-[var(--primary)]\" data-kid=\"2-1-2-1-1-2-6-2-2\" data-name=\"VIP toggle switch\"><span class=\"absolute top-[3px] right-[3px] h-[22px] w-[22px] rounded-full bg-[var(--on-primary)]\" data-kid=\"2-1-2-1-1-2-6-2-2-1\" data-name=\"toggle switch knob (on)\"></span></span>\n</div>\n</div>\n</div>\n<div class=\"flex h-[84px] shrink-0 items-center justify-between border-t border-[var(--line)] px-6\" data-kid=\"2-1-2-1-1-3\" data-name=\"form footer actions\">\n<button class=\"h-12 rounded-xl border border-[var(--edge)] px-5 text-sm font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-1-1-3-1\" data-name=\"cancel button\">Cancel</button>\n<button class=\"h-12 min-w-[164px] rounded-xl bg-[var(--primary)] px-6 text-sm font-semibold text-[var(--on-primary)]\" data-kid=\"2-1-2-1-1-3-2\" data-name=\"save customer button\">Save customer</button>\n</div>\n</section>\n<section class=\"flex flex-1 flex-col justify-between rounded-2xl bg-[var(--surface)] p-5 shadow-[var(--sh-low)]\" data-kid=\"2-1-2-1-2\" data-name=\"backup progress card\">\n<div class=\"flex items-center justify-between\" data-kid=\"2-1-2-1-2-1\" data-name=\"backup card header\">\n<h2 class=\"text-[17px] font-bold\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"backup section title\">Backup</h2>\n<button class=\"h-10 rounded-xl border border-[var(--edge)] px-4 text-[13px] font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-1-2-1-2\" data-name=\"cancel backup button\">Cancel backup</button>\n</div>\n<div data-kid=\"2-1-2-1-2-2\" data-name=\"backup progress details\">\n<div class=\"flex items-baseline justify-between text-sm\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"backup progress status row\">\n<span class=\"font-semibold\" data-kid=\"2-1-2-1-2-2-1-1\" data-name=\"backup status label\">Compressing files</span>\n<span class=\"tabular-nums text-[var(--muted)]\" data-kid=\"2-1-2-1-2-2-1-2\" data-name=\"backup file count and percentage\"><b class=\"font-semibold text-[var(--text)]\" data-kid=\"2-1-2-1-2-2-1-2-1\" data-name=\"backup current file count\">312</b> of 540 files · 58%</span>\n</div>\n<div class=\"mt-2 h-2.5 rounded-full bg-[var(--well2)] shadow-[var(--sh-well)]\" data-kid=\"2-1-2-1-2-2-2\" data-name=\"backup progress track\"><div cl