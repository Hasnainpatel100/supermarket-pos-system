5 text-sm font-semibold text-[var(--muted)] hover:text-[var(--text)]\" data-kid=\"2-1-2-1-2-1\" data-name=\"export button\"><i class=\"mdi mdi-tray-arrow-down text-lg\" data-kid=\"2-1-2-1-2-1-1\" data-name=\"download tray export icon\"></i>Export</button>\n<button class=\"flex h-10 items-center gap-2 rounded-xl border border-[var(--edge)] px-4 text-sm font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-1-2-2\" data-name=\"import button\"><i class=\"mdi mdi-tray-arrow-up text-lg\" data-kid=\"2-1-2-1-2-2-1\" data-name=\"upload tray import icon\"></i>Import</button>\n<button class=\"flex h-10 items-center gap-2 rounded-xl bg-[var(--primary)] px-4 text-sm font-semibold text-[var(--on-primary)] shadow-[var(--sh-up)]\" data-kid=\"2-1-2-1-2-3\" data-name=\"add item button\"><i class=\"mdi mdi-plus text-lg\" data-kid=\"2-1-2-1-2-3-1\" data-name=\"plus add icon\"></i>Add item</button>\n</div>\n</header>\n<div class=\"mt-3 flex min-h-0 flex-1 gap-4\" data-kid=\"2-1-2-2\" data-name=\"main two-pane workspace\">\n<!-- Inset inventory -->\n<section class=\"flex w-[860px] shrink-0 flex-col rounded-2xl bg-[var(--inset)] p-3 shadow-[var(--sh-in)]\" data-kid=\"2-1-2-2-1\" data-name=\"inventory list panel\">\n<label class=\"flex h-12 shrink-0 items-center gap-3 rounded-xl border border-[var(--edge)] bg-[var(--input)] px-4\" data-kid=\"2-1-2-2-1-1\" data-name=\"inventory search bar\">\n<i class=\"mdi mdi-magnify text-xl text-[var(--muted)]\" data-kid=\"2-1-2-2-1-1-1\" data-name=\"magnifier search icon\"></i>\n<input class=\"h-full flex-1 bg-transparent text-sm outline-hidden placeholder:text-[var(--muted)]\" data-kid=\"2-1-2-2-1-1-2\" data-name=\"item search input\" placeholder=\"Search item name, SKU or barcode\"/>\n<i class=\"mdi mdi-barcode-scan text-xl text-[var(--muted)]\" data-kid=\"2-1-2-2-1-1-3\" data-name=\"barcode scan icon\" title=\"Scan barcode\"></i>\n</label>\n<div class=\"mt-2 flex h-12 shrink-0 items-center justify-between\" data-kid=\"2-1-2-2-1-2\" data-name=\"lis