ata-name=\"customer name input field\" value=\"Priya Raghavan\"/>\n</div>\n<div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-1-2-2-2-1-2-2\" data-name=\"phone-email grid row\">\n<div data-kid=\"2-1-2-2-2-1-2-2-1\" data-name=\"phone field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-2-1-1\" data-name=\"phone label\">Phone</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden\" data-kid=\"2-1-2-2-2-1-2-2-1-2\" data-name=\"phone input field\" value=\"98450 12763\"/></div>\n<div data-kid=\"2-1-2-2-2-1-2-2-2\" data-name=\"email field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-2-2-1\" data-name=\"email label\">Email</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden\" data-kid=\"2-1-2-2-2-1-2-2-2-2\" data-name=\"email input field\" value=\"priya.r@gmail.com\"/></div>\n</div>\n<div data-kid=\"2-1-2-2-2-1-2-3\" data-name=\"street address field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-3-1\" data-name=\"street address label\">Street address</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden\" data-kid=\"2-1-2-2-2-1-2-3-2\" data-name=\"street address input field\" value=\"12, 4th Cross, Jayanagar 3rd Block\"/></div>\n<div class=\"grid grid-cols-2 gap-3\" data-kid=\"2-1-2-2-2-1-2-4\" data-name=\"city-state grid row\">\n<div data-kid=\"2-1-2-2-2-1-2-4-1\" data-name=\"city field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-1-1\" data-name=\"city label\">City</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden\" data-kid=\"2-1-2-2-2-1-2-4-1-2\" data-name=\"city input field\" value=\"Bengaluru\"/></div>\n<div data-kid=\"2-1-2-2-2-1-2-4-2\" data-name=\"state field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-2-1\" data-name=\"state label\">State</label>\n<div class=\"flex h-11 w-full items-center justify-between rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm\" data-kid=\"2-1-2-2-2-1-2-4-2-2\" data-name=\"state selector dropdown\">Karnataka <i class=\"mdi mdi-chevron-down text-lg text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-4-2-2-1\" data-name=\"dropdown chevron down icon\"></i></div></div>\n</div>\n<div class=\"grid grid-cols-2 items-end gap-3\" data-kid=\"2-1-2-2-2-1-2-5\" data-name=\"zip-vip grid row\">\n<div data-kid=\"2-1-2-2-2-1-2-5-1\" data-name=\"zip code field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-5-1-1\" data-name=\"zip code label\">ZIP code</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden\" data-kid=\"2-1-2-2-2-1-2-5-1-2\" data-name=\"zip code input field\" value=\"560011\"/></div>\n<div class=\"flex h-11 items-center justify-between rounded-xl border border-[var(--edge)] px-3.5\" data-kid=\"2-1-2-2-2-1-2-5-2\" data-name=\"VIP toggle row\">\n<span class=\"flex items-center gap-2 text-sm font-medium\" data-kid=\"2-1-2-2-2-1-2-5-2-1\" data-name=\"VIP customer label\"><i class=\"mdi mdi-star-outline text-lg\" data-kid=\"2-1-2-2-2-1-2-5-2-1-1\" data-name=\"star icon\"></i>VIP customer</span>\n<span class=\"relative h-6 w-11 rounded-full bg-[var(--primary)]\" data-kid=\"2-1-2-2-2-1-2-5-2-2\" data-name=\"VIP toggle switch\"><span class=\"absolute top-[3px] right-[3px] h-[18px] w-[18px] rounded-full bg-[var(--on-primary)]\" data-kid=\"2-1-2-2-2-1-2-5-2-2-1\" data-name=\"VIP toggle switch thumb\"></span></span>\n</div>\n</div>\n<div data-kid=\"2-1-2-2-2-1-2-6\" data-name=\"notes field group\"><label class=\"mb-1 block text-[13px] font-medium text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-6-1\" data-name=\"notes label\">Notes</label><input class=\"h-11 w-full rounded-xl border border-[var(--edge)] bg-[var(--well)] px-3.5 text-sm outline-hidden placeholder:text-[var(--muted)]\" data-kid=\"2-1-2-2-2-1-2-6-2\" data-name=\"notes input field\" placeholder=\"Optional\"/></div>\n</div>\n<div class=\"flex h-16 items-center justify-between border-t border-[var(--line)] px-5\" data-kid=\"2-1-2-2-2-1-3\" data-name=\"form card footer\">\n<button class=\"flex h-10 w-10 items-center justify-center rounded-xl text-[var(--muted)] hover:bg-[var(--hover)]\" data-kid=\"2-1-2-2-2-1-3-1\" data-name=\"more options button\" title=\"More\"><i class=\"mdi mdi-dots-horizontal text-xl\" data-kid=\"2-1-2-2-2-1-3-1-1\" data-name=\"dots horizontal icon\"></i></button>\n<div class=\"flex items-center gap-2\" data-kid=\"2-1-2-2-2-1-3-2\" data-name=\"form action buttons group\">\n<button class=\"h-11 rounded-xl px-4 text-sm font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-2-2-1-3-2-1\" data-name=\"cancel button\">Cancel</button>\n<button class=\"flex h-11 items-center gap-2 rounded-xl bg-[var(--primary)] px-5 text-sm font-semibold text-[var(--on-primary)] shadow-[var(--shadow)]\" data-kid=\"2-1-2-2-2-1-3-2-2\" data-name=\"save customer button\"><i class=\"mdi mdi-content-save-outline text-lg\" data-kid=\"2-1-2-2-2-1-3-2-2-1\" data-name=\"save (content save) icon\"></i>Save customer</button>\n</div>\n</div>\n</section>\n<section class=\"flex flex-1 flex-col justify-between rounded-2xl bg-[var(--card)] p-5 shadow-[var(--shadow)]\" data-kid=\"2-1-2-2-2-2\" data-name=\"backup status card\">\n<div class=\"flex items-center justify-between\" data-kid=\"2-1-2-2-2-2-1\" data-name=\"backup card header\">\n<h2 class=\"text-[17px] font-bold\" data-kid=\"2-1-2-2-2-2-1-1\" data-name=\"backup card title\">Backup</h2>\n<button class=\"flex h-10 items-center gap-2 rounded-xl bg-[var(--primary)] px-4 text-[13px] font-semibold text-[var(--on-primary)]\" data-kid=\"2-1-2-2-2-2-1-2\" data-name=\"backup now button\"><i class=\"mdi mdi-backup-restore text-lg\" data-kid=\"2-1-2-2-2-2-1-2-1\" data-name=\"backup restore icon\"></i>Back up now</button>\n</div>\n<dl class=\"grid grid-cols-[1.4fr_1.2fr_0.7fr] gap-4\" data-kid=\"2-1-2-2-2-2-2\" data-name=\"backup details list\">\n<div data-kid=\"2-1-2-2-2-2-2-1\" data-name=\"destination field group\"><dt class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-1-1\" data-name=\"destination label\">Destination</dt><dd class=\"mt-0.5 truncate text-sm font-semibold\" data-kid=\"2-1-2-2-2-2-2-1-2\" data-name=\"destination value\">D:\\RH POS\\Backups</dd></div>\n<div data-kid=\"2-1-2-2-2-2-2-2\" data-name=\"last backup field group\"><dt class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-2-1\" data-name=\"last backup label\">Last backup</dt><dd class=\"mt-0.5 text-sm font-semibold\" data-kid=\"2-1-2-2-2-2-2-2-2\" data-name=\"last backup value\">31 Oct 2026, 21:40</dd></div>\n<div data-kid=\"2-1-2-2-2-2-2-3\" data-name=\"state field group\"><dt class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-1-2-2-2-2-2-3-1\" data-name=\"state label\">State</dt><dd class=\"mt-0.5 flex items-center gap-1.5 text-sm font-semibold\" data-kid=\"2-1-2-2-2-2-2-3-2\" data-name=\"state value with status dot\"><span class=\"h-2 w-2 rounded-full bg-[var(--teal)]\" data-kid=\"2-1-2-2-2-2-2-3-2-1\" data-name=\"active status indicator dot\"></span>Idle</dd></div>\n</dl>\n</section>\n</div>\n</div>\n</main>\n</div>\n</template>\n<script>\nconst items=[\n[\"Frooti Mango Juice Tetrapack 160ml\",\"SKU-BV-041\",\"8901614010411\",\"Pack\",8.5,10,48,\"14 Jan 2027\"],\n[\"Real Fruit Power Mixed Fruit Juice 1L\",\"SKU-BV-042\",\"8901207010427\",\"Pack\",105,125,0,\"02 Dec 2026\"],\n[\"Red Bull Energy Drink Can 250ml\",\"SKU-BV-043\",\"9002490100438\",\"Can\",110,125,36,\"20 Jun 2027\"],\n[\"Bisleri Packaged Drinking Water 1L\",\"SKU-BV-044\",\"8906014400442\",\"Bottle\",14,20,120,\"\"],\n[\"Parle-G Gold Glucose Biscuits 1kg Family Pack\",\"SKU-SN-045\",\"8901719010457\",\"Pack\",110,125,0,\"08 Mar 2027\"],\n[\"Britannia Good Day Butter Cookies 600g\",\"SKU-SN-046\",\"8901063030463\",\"Pack\",120,140,22,\"19 Feb 2027\"],\n[\"Britannia Marie Gold Biscuits 300g\",\"SKU-SN-047\",\"8901063040479\",\"Pack\",42,50,64,\"11 Jan 2027\"],\n[\"Cadbury Oreo Original Vanilla 120g\",\"SKU-SN-048\",\"8901233020483\",\"Pack\",32,40,0,\"27 Dec 2026\"],\n[\"Sunfeast Dark Fantasy Choco Fills 300g\",\"SKU-SN-049\",\"8901725030495\",\"Pack\",130,150,18,\"05 Apr 2027\"],\n[\"Haldiram's Aloo Bhujia 400g\",\"SKU-SN-050\",\"8904004400502\",\"Pack\",95,110,15,\"22 Jan 2027\"],\n[\"Amul Taaza Toned Milk 1L\",\"SKU-DR-051\",\"8901262010511\",\"Pouch\",54,58,40,\"04 Nov 2026\"],\n[\"Tata Salt Iodised 1kg\",\"SKU-GR-052\",\"8904043901015\",\"Pack\",24,28,85,\"\"]\n];\nconst inr=n=>'₹'+n.toFixed(2);\nconst rows=items.map(([n,s,b,u,c,p,st,e])=>`\n<div class=\"grid h-11 grid-cols-[20px_minmax(0,1fr)_84px_108px_52px_70px_70px_48px_84px_28px] items-center gap-2 border-b border-[var(--line)] px-2 text-[13px] hover:bg-[var(--hover)]\">\n  <span class=\"h-4 w-4 rounded-[5px] border-[1.5px] border-[var(--edge)] bg-[var(--card)]\"></span>\n  <span class=\"truncate text-sm font-semibold\" title=\"${n}\">${n}</span>\n  <span class=\"text-[var(--muted)]\">${s}</span>\n  <span class=\"font-mono text-[12px] text-[var(--muted)]\">${b}</span>\n  <span>${u}</span>\n  <span class=\"text-right tabular-nums text-[var(--muted)]\">${inr(c)}</span>\n  <span class=\"text-right font-semibold tabular-nums\">${inr(p)}</span>\n  <span class=\"text-right font-semibold tabular-nums ${st===0?'text-[var(--danger)]':''}\">${st}</span>\n  <span class=\"${e?'':'text-[var(--muted)]'}\">${e||'No batch'}</span>\n  <button title=\"Actions\" class=\"flex h-7 w-7 items-center justify-center rounded-lg text-[var(--muted)] hover:bg-[var(--well)]\"><i class=\"mdi mdi-dots-vertical text-lg\"></i></button>\n</div>`).join('');\nconst tpl=document.getElementById('tpl');\n['screen-light','screen-dark'].forEach(id=>document.getElementById(id).appendChild(tpl.content.cloneNode(true)));\ndocument.querySelectorAll('[data-rows]').forEach(el=>el.innerHTML=rows);\n</script>",
