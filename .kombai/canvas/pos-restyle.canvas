ata-name=\"pagination controls\">\n<button class=\"flex h-10 items-center gap-1 rounded-xl px-3 text-[13px] font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-2-5-2-1\" data-name=\"previous page button\"><i class=\"mdi mdi-arrow-left text-base\" data-kid=\"2-1-2-2-5-2-1-1\" data-name=\"left arrow icon\"></i>Prev</button>\n<span class=\"px-2 text-[13px] font-semibold\" data-kid=\"2-1-2-2-5-2-2\" data-name=\"current page indicator\">Page 3 of 5</span>\n<button class=\"flex h-10 items-center gap-1 rounded-xl px-3 text-[13px] font-semibold hover:bg-[var(--hover)]\" data-kid=\"2-1-2-2-5-2-3\" data-name=\"next page button\">Next<i class=\"mdi mdi-arrow-right text-base\" data-kid=\"2-1-2-2-5-2-3-1\" data-name=\"right arrow icon\"></i></button>\n</div>\n</footer>\n</section>\n</main>\n</div>\n</template>\n<script>\nconst items=[\n[\"Frooti Mango Juice Tetrapack 160ml\",\"SKU-BV-041\",\"8901614010411\",\"Pack\",8.5,10,48,\"14 Jan 2027\"],\n[\"Real Fruit Power Mixed Fruit Juice 1L\",\"SKU-BV-042\",\"8901207010427\",\"Pack\",105,125,0,\"02 Dec 2026\"],\n[\"Red Bull Energy Drink Can 250ml\",\"SKU-BV-043\",\"9002490100438\",\"Can\",110,125,36,\"20 Jun 2027\"],\n[\"Bisleri Packaged Drinking Water 1L\",\"SKU-BV-044\",\"8906014400442\",\"Bottle\",14,20,120,\"\"],\n[\"Parle-G Gold Glucose Biscuits 1kg Family Pack\",\"SKU-SN-045\",\"8901719010457\",\"Pack\",110,125,0,\"08 Mar 2027\"],\n[\"Britannia Good Day Butter Cookies 600g\",\"SKU-SN-046\",\"8901063030463\",\"Pack\",120,140,22,\"19 Feb 2027\"],\n[\"Britannia Marie Gold Biscuits 300g\",\"SKU-SN-047\",\"8901063040479\",\"Pack\",42,50,64,\"11 Jan 2027\"],\n[\"Cadbury Oreo Original Vanilla 120g\",\"SKU-SN-048\",\"8901233020483\",\"Pack\",32,40,0,\"27 Dec 2026\"],\n[\"Sunfeast Dark Fantasy Choco Fills 300g\",\"SKU-SN-049\",\"8901725030495\",\"Pack\",130,150,18,\"05 Apr 2027\"],\n[\"Haldiram's Aloo Bhujia 400g\",\"SKU-SN-050\",\"8904004400502\",\"Pack\",95,110,15,\"22 Jan 2027\"],\n[\"Amul Taaza Toned Milk 1L\",\"SKU-DR-051\",\"8901262010511\",\"Pouch\",54,58,40,\"04 Nov 2026\"],\n[\"Tata Salt Iodised 1kg\",\"SKU-GR-052\",\"8904043901015\",\"Pack\",24,28,85,\"\"]\n];\nconst inr=n=>'₹'+n.toFixed(2);\nconst rows=items.map(([n,s,b,u,c,p,st,e])=>`\n<div class=\"group grid h-11 grid-cols-[250px_96px_88px_64px_124px_60px_84px_100px_40px] items-center border-b border-[var(--line)] text-sm\">\n  <span class=\"sticky left-0 z-10 flex h-full items-center bg-[var(--surface)] pl-1 pr-3\"><span class=\"truncate font-semibold\" title=\"${n}\">${n}</span></span>\n  <span class=\"text-[13px] text-[var(--muted)]\">${s}</span>\n  <span class=\"text-right font-semibold tabular-nums\">${inr(p)}</span>\n  <span class=\"text-right font-semibold tabular-nums ${st===0?'text-[var(--danger)]':''}\">${st}</span>\n  <span class=\"pl-6 font-mono text-[12px] text-[var(--muted)]\">${b}</span>\n  <span class=\"text-[13px]\">${u}</span>\n  <span class=\"text-right tabular-nums text-[var(--muted)]\">${inr(c)}</span>\n  <span class=\"pl-5 text-[13px] ${e?'':'text-[var(--muted)]'}\">${e||'No batch'}</span>\n  <button title=\"Actions\" class=\"flex h-8 w-8 items-center justify-center rounded-lg text-[var(--muted)] hover:bg-[var(--hover)]\"><i class=\"mdi mdi-dots-vertical text-lg\"></i></button>\n</div>`).join('');\nconst tpl=document.getElementById('tpl');\n['screen-light','screen-dark'].forEach(id=>document.getElementById(id).appendChild(tpl.content.cloneNode(true)));\ndocument.querySelectorAll('[data-rows]').forEach(el=>el.innerHTML=rows);\n</script>",
